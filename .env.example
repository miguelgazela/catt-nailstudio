# Copiar para .env.local (nunca commitar). Sem valores reais neste ficheiro.
# Preenchido a partir de M1/M2:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # só servidor, via `wrangler secret`
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=           # só servidor
# RATE_LIMIT_SALT=                # só servidor, texto aleatório (openssl rand -hex 32)
# RESEND_API_KEY=                 # só servidor
# EMAIL_FROM=Catarina Neves Nails Studio <marcacoes@catt-nailstudio.miguelgazela.com>   # até haver domínio: onboarding@resend.dev
# EMAIL_REPLY_TO=email-da-catarina@exemplo.com   # opcional: para onde vão as respostas das clientes
# SITE_URL=https://catt-nailstudio.vercel.app                      # links nos emails
# CRON_SECRET=                    # só servidor, igual ao segredo `cron_secret` no Vault do Supabase
# Notificações push da Catarina (Web Push). Gerar um par com `pnpm dlx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=              # só servidor
# VAPID_SUBJECT=mailto:geral@dominio.pt
# PAINEL_SESSAO_SECRET=           # só servidor, texto aleatório (openssl rand -hex 32); sem ele usa a chave secreta do Supabase
